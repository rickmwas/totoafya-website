14:["$","section",null,{"className":"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6","children":[["$","div",null,{"className":"space-y-2","children":[["$","span",null,{"className":"badge-trust","children":"FAQ Knowledge Base"}],["$","h2",null,{"className":"text-2xl font-bold text-slate-900","children":"Frequently Asked Questions"}]]}],["$","div",null,{"className":"space-y-4","children":[["$","div","How does TotoAfya handle offline environments in rural clinics?",{"className":"rounded-xl bg-white border border-slate-200 p-6 space-y-2","children":[["$","h3",null,{"className":"text-sm font-bold text-slate-900","children":"How does TotoAfya handle offline environments in rural clinics?"}],["$","p",null,{"className":"text-xs text-slate-600 leading-relaxed","children":"TotoAfya Digital utilizes an encrypted client-side storage engine (IndexedDB) that permits clinical nurses and CHVs to register patients, log vitals, record ANC parameters, and view KEPI schedules without internet connectivity. Once a mobile network connection is detected, data synchronizes to cloud servers through a background sync queue."}]]}],["$","div","Is TotoAfya compliant with Kenya Data Protection Act 2019?",{"className":"rounded-xl bg-white border border-slate-200 p-6 space-y-2","children":[["$","h3",null,{"className":"text-sm font-bold text-slate-900","children":"Is TotoAfya compliant with Kenya Data Protection Act 2019?"}],["$","p",null,{"className":"text-xs text-slate-600 leading-relaxed","children":"Yes. Patient records are encrypted in transit and at rest. Access controls enforce strict role-based authorization (Mother, Nurse, Facility Lead, County Admin), ensuring health workers only access data for their authorized facility."}]]}],["$","div","Can health facilities pay using Safaricom M-Pesa?",{"className":"rounded-xl bg-white border border-slate-200 p-6 space-y-2","children":[["$","h3",null,{"className":"text-sm font-bold text-slate-900","children":"Can health facilities pay using Safaricom M-Pesa?"}],["$","p",null,{"className":"text-xs text-slate-600 leading-relaxed","children":"Yes. Facility subscriptions and caregiver plans support Lipa na M-Pesa STK push transactions. Institutions can also request formal invoicing for local bank transfers or county check processing."}]]}],["$","div","Does TotoAfya replace clinical diagnosis or doctors?",{"className":"rounded-xl bg-white border border-slate-200 p-6 space-y-2","children":[["$","h3",null,{"className":"text-sm font-bold text-slate-900","children":"Does TotoAfya replace clinical diagnosis or doctors?"}],["$","p",null,{"className":"text-xs text-slate-600 leading-relaxed","children":"No. TotoAfya Digital is a clinical workflow and supportive guidance engine. The 24/7 AI Health Companion is strictly non-diagnostic, offering educational information based on WHO protocols and directing mothers to their assigned health facility whenever red-flag symptoms arise."}]]}],["$","div","How can county health departments pilot TotoAfya?",{"className":"rounded-xl bg-white border border-slate-200 p-6 space-y-2","children":[["$","h3",null,{"className":"text-sm font-bold text-slate-900","children":"How can county health departments pilot TotoAfya?"}],["$","p",null,{"className":"text-xs text-slate-600 leading-relaxed","children":"County health directors and program leads can contact our partnerships team at partnerships@totoafya.co.ke or via our contact form to arrange a pilot demonstration and custom deployment assessment."}]]}]]}]]}]
